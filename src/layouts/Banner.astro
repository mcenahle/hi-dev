---
import { Icon } from "astro-icon/components";
---

<div class="official-banner">
  <div class="mx-3 py-1" style="margin-top: 0;">
    <div class="d-flex align-items-center flex-wrap gap-0.5">
      <span aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none" />
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M8.32 2.38c.19-.37.64-.51 1.01-.33l2.68 1.35l2.68-1.35a.75.75 0 0 1 1.01.33l1.37 2.67l2.96.48c.41.07.68.45.62.85l-.46 2.96l2.11 2.13c.29.29.29.76 0 1.06l-2.11 2.13l.46 2.96a.74.74 0 0 1-.62.85l-2.96.48l-1.37 2.67c-.19.37-.64.51-1.01.33l-2.68-1.35l-2.68 1.35a.75.75 0 0 1-1.01-.33l-1.37-2.67l-2.96-.48a.75.75 0 0 1-.62-.85l.46-2.96l-2.11-2.13a.754.754 0 0 1 0-1.06l2.11-2.13l-.46-2.96a.74.74 0 0 1 .62-.85l2.96-.48zm2.18 11.55l5.22-5.22l1.06 1.06l-5.4 5.39c-.49.49-1.28.49-1.77 0l-1.89-1.89l1.06-1.06z"
            clip-rule="evenodd"
          />
        </svg>
      </span>
      &nbsp;
      <span class="small"> 来自 mcenahle 的官方网站。 </span>
      <button
        class="btn btn-link btn-sm p-0"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#bannerDetails"
        aria-expanded="false"
        aria-controls="bannerDetails"
      >
        你可以通过以下方式确认。 <Icon name="mdi:keyboard-arrow-down" />
      </button>
    </div>

    <div class="collapse" id="bannerDetails">
      <div class="row g-4 py-4 px-4">
        <div class="md:col-6">
          <h2 class="h6 fw-bold" style="font-size: 1.1rem;">
            官方个人主页网站使用 hi.mcenahle.page
          </h2>
          <p class="mb-0">
            一个 <code>mcenahle.page</code> 网站意味着你位于{" "}
            <a href="https://mcenahle.dev/ecosystem/" target="_blank">
              <u>mcenahle 的生态系统</u>&nbsp;
              <Icon name="mdi:open-in-new" />
            </a>{" "}
            之中，且由于是 <code>hi.mcenahle.page</code>，二级域为{" "}
            <code>hi</code>，为 mcenahle 的个人主页网站。
          </p>
        </div>

        <div class="md:col-6">
          <h2 class="fw-bold" style="font-size: 1.1rem;">
            安全网站使用 <code>HTTPS</code>
          </h2>
          <p class="mb-0">
            一把锁的标志（
            <Icon name="mdi:lock" />
            ），或者 <code>https://</code> 前缀，意味着你已经安全的连接到了
            mcenahle 的网站。
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .official-banner {
    background-color: #08678f;
    color: white;
    .btn-link,
    a {
      color: white;
    }
  }
</style>
