---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a class="breadcrumb-link" href="/">mcenahle 个人门户网站</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item">
        <a class="breadcrumb-link" href="/annual/">年终总结</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item" aria-current="page">
        <a class="breadcrumb-link active" href="javascript:void(0)"
          >{frontmatter.title}</a
        >
      </li>
    </ol>
  </nav>

  <div class="row">
    <div class="col-12 lg:col-8">
      <h2 style="text-align: center; font-size: 30px; margin-top: 30px;">
        {frontmatter.title}
      </h2>

      <div class="post-meta">
        <span>
          <Icon name="mdi:account-edit" />&nbsp;
          {frontmatter.author}
        </span>

        <span>
          <Icon name="mdi:calendar" />&nbsp;
          {frontmatter.date}
        </span>

        <div class="article">
          <slot />
        </div>
      </div>
    </div>
    <div class="col-12 lg:col-4">
      <p>查看关联的 pdf 文件：</p>
      <iframe class="annualpdfjs" src={frontmatter.pdfjs}></iframe>
      <hr />
      <div class="row">
        <div class="col-12 lg:col-6">
          <div class="d-grid gap-2">
            <a
              href={frontmatter.pdflink}
              class="theme-accent btn-solid btn-styled"
              style="margin-bottom: 6px;"
            >
              查看 pdf 源文件
            </a>
          </div>
        </div>
        <div class="col-12 lg:col-6">
          <div class="d-grid gap-2">
            <button
              type="button"
              class="theme-success btn-solid btn-styled"
              data-bs-toggle="dialog"
              data-bs-target="#pdfDownloadDialog"
              style="margin-bottom: 12px;"
            >
              下载 pdf
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a
    class="theme-primary btn-solid btn-styled"
    href="/annual/"
    role="button"
    style="text-indent: 0em;"><Icon name="mdi:arrow-left" /> 返回年终总结</a
  >

  <dialog class="dialog dialog-slide-down" id="pdfDownloadDialog">
    <div class="dialog-header">
      <h1 class="dialog-title">下载确认</h1>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="dialog"
        aria-label="Close"></button>
    </div>
    <div class="dialog-body">这将直接在本页面中进行下载，是否继续？</div>
    <div class="dialog-footer">
      <button
        type="button"
        class="btn-solid theme-secondary"
        data-bs-dismiss="dialog">取消</button
      >
      <a href={frontmatter.pdflink} download class="btn-solid theme-primary"
        >下载</a
      >
    </div>
  </dialog>
</Layout>
