---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a class="breadcrumb-link" href="/">mcenahle 个人门户网站</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item">
        <a class="breadcrumb-link" href="/annual/">年终总结</a>
      </li>
      <li class="breadcrumb-divider"></li>
      <li class="breadcrumb-item" aria-current="page">
        <a class="breadcrumb-link active" href="javascript:void(0)"
          >{frontmatter.title}</a
        >
      </li>
    </ol>
  </nav>

  <div class="panel panel-default">
    <div class="page-heading" style="margin: 0 auto;">
      <h2 style="text-align: center; font-size: 30px; margin-top: 30px;">
        {frontmatter.title}
      </h2>

      <div class="post-meta">
        <span>
          <Icon name="mdi:account-edit" />&nbsp;
          {frontmatter.author}
        </span>

        <span>
          <Icon name="mdi:calendar" />&nbsp;
          {frontmatter.date}
        </span>
      </div>
    </div>
    <div class="panel-body">
      <div class="article">
        <slot />
        <a
          class="theme-primary btn-solid btn-styled"
          href="/annual/"
          role="button"
          style="text-indent: 0em;"
          ><Icon name="mdi:arrow-left" /> 返回年终总结</a
        >
      </div>
    </div>
  </div>
</Layout>
